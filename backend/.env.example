# PackCheck AI Backend Environment Configuration (Example)
# Copy this file to .env or set environment variables in your cloud deployment platform

# Server Port
PORT=8080

# Database Configuration (MySQL / H2)
DB_URL=jdbc:mysql://localhost:3306/packcheck_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=password
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# AI OCR Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Security & JWT Configuration
# IMPORTANT: In production, override JWT_SECRET with a strong 256-bit secret key!
JWT_SECRET=PackCheckPrototypeSecretKeyForJwtTokenGeneration2026!SIH26034
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# File Upload Storage Directory
UPLOAD_DIR=uploads
